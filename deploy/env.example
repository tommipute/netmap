# Impostazioni di NetMap (install.sh crea .env da questo modello con password casuale e indirizzo del server).
# Dopo una modifica: docker compose up -d

# Indirizzo con cui si apre NetMap: nome del server o IP (si apre con https://NETMAP_HOST)
NETMAP_HOST=netmap.example.local
# https, oppure http per restare senza HTTPS (poi NETMAP_TLS vuoto e COOKIE_SECURE=false)
NETMAP_SCHEME=https
# Certificato HTTPS (vedi Caddyfile):
#   tls internal                              CA interna di Caddy: il browser avvisa finché non la installi nei PC
#   tls admin@example.com                     Let's Encrypt, solo se il server è raggiungibile da Internet su 80 e 443
#   tls /certs/netmap.crt /certs/netmap.key   certificato vostro, file nella cartella certs/
#   (vuoto con NETMAP_SCHEME=http)
NETMAP_TLS=tls internal
# Il cookie di sessione viaggia solo su HTTPS: false soltanto con NETMAP_SCHEME=http
COOKIE_SECURE=true
# Porte del server (80 serve anche per il passaggio automatico da http a https)
HTTP_PORT=80
HTTPS_PORT=443

# Versione installata: la cambia l'updater a ogni aggiornamento (oppure a mano, poi docker compose up -d)
NETMAP_VERSION=
# Registro delle immagini
NETMAP_IMAGE=ghcr.io/tommipute/netmap

# Database (la password la genera install.sh: non cambiarla dopo l'installazione)
POSTGRES_USER=netmap
POSTGRES_PASSWORD=
POSTGRES_DB=netmap

# Chiave che cifra le credenziali SNMP: vuota = generata in data/secrets_key (tienila con i backup)
SECRETS_KEY=

TZ=Europe/Rome
SESSION_HOURS=12
# Stato live: ogni quanti secondi ping/SNMP sui device con IP di management (0 = spento)
MONITOR_INTERVAL_SECONDS=60
