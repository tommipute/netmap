# HTTPS davanti a NetMap (Caddy). Indirizzo e certificato arrivano dal file .env:
#   NETMAP_HOST     nome del server o IP (netmap.azienda.local, 192.168.1.75)
#   NETMAP_SCHEME   https, oppure http per restare senza HTTPS (con NETMAP_TLS vuoto e COOKIE_SECURE=false)
#   NETMAP_TLS      tls internal                         certificato della CA di Caddy (da installare nei PC)
#                   tls admin@azienda.it                 Let's Encrypt (server raggiungibile da Internet sulle porte 80 e 443)
#                   tls /certs/netmap.crt /certs/netmap.key   certificato vostro, file nella cartella certs/
#                   (vuoto con http)
# Questo file viene sostituito a ogni aggiornamento: le personalizzazioni vanno in .env.

{
	# Chi apre https://IP non manda il nome del server (SNI): senza questa riga Caddy non sa che certificato dare
	default_sni {$NETMAP_HOST}
}

{$NETMAP_SCHEME}://{$NETMAP_HOST} {
	{$NETMAP_TLS}
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		-Server
	}

	reverse_proxy web:80
}
