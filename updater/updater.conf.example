# Configurazione dell'updater (install.sh la copia in updater/updater.conf, che non va su git).
# Le impostazioni che cambiano spesso (aggiornamento automatico, branch, intervallo, backup da tenere)
# si gestiscono dall'app, pagina Aggiornamenti: finiscono in updater-data/settings.json.

# docker = repo git + docker compose build | vm = repo git, app direttamente sul server
# image = installata con deploy/install.sh: immagini dal registro, canale stable/beta (scelto nell'app);
#         il registro e la versione installata stanno nel .env (NETMAP_IMAGE, NETMAP_VERSION), git non serve
MODE=docker

# Cartella del repo (vuota = la cartella sopra updater/), cartella condivisa con l'app, backup del database
#APP_DIR=/opt/netmap
#DATA_DIR=/opt/netmap/updater-data
#BACKUP_DIR=/opt/netmap/backups   # se la cambi, monta la stessa cartella in /backups nei container api e worker

# Remote git e chiave SSH di sola lettura (deploy key). Vuota = quella di ~/.ssh/config per github.com
REMOTE=origin
#GIT_SSH_KEY=/home/netmap/.ssh/netmap_deploy

# Controllo di salute dopo l'aggiornamento (modalità image: dall'interno dei container, gli indirizzi non servono): l'API deve rispondere ok con il commit nuovo entro HEALTH_TIMEOUT secondi
HEALTH_URL=http://127.0.0.1:8001/api/health
# Anche l'interfaccia deve rispondere (vuoto = non controllarla)
WEB_URL=http://127.0.0.1:5174/
HEALTH_TIMEOUT=300
HEALTH_INTERVAL=5

# ---- Solo MODE=vm: comandi del server senza Docker (eseguiti nella cartella del repo)
# Installa le dipendenze e riavvia i servizi; l'API applica le migration all'avvio (backend/start.sh).
# I servizi devono leggere version.env (systemd: EnvironmentFile=/opt/netmap/version.env).
#VM_DEPLOY_CMD='cd backend && .venv/bin/pip install -q -r requirements.txt && cd ../frontend && npm ci && npm run build && sudo systemctl restart netmap-api netmap-worker netmap-monitor'
#VM_STOP_CMD='sudo systemctl stop netmap-api netmap-worker netmap-monitor'
# Database per backup e ripristino (pg_dump, psql e pg_restore installati sul server)
#VM_DATABASE_URL=postgresql://netmap:password@localhost:5432/netmap
#HEALTH_URL=http://127.0.0.1:8000/api/health
#WEB_URL=
