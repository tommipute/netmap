# Copia questo file in .env e cambia la password
POSTGRES_USER=netmap
POSTGRES_PASSWORD=admin
POSTGRES_DB=netmap

# Chiave per cifrare community e chiavi SNMP. Se resta vuota viene generata in backend/.secrets_key
# (non cancellare quel file, altrimenti i profili SNMP vanno reinseriti)
SECRETS_KEY=

# Su Linux il controllo dei file cambiati funziona senza polling: metti false (su Windows lascia true)
FILE_POLLING=true
# Nomi host da cui si apre l'interfaccia oltre a IP e localhost (separati da virgola)
VITE_ALLOWED_HOSTS=.netbird.cloud
