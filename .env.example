# Copia questo file in .env e cambia la password

# Solo sul server di produzione: interfaccia compilata servita da nginx, codice dentro le immagini
# (vedi "Produzione" nel README). In sviluppo lascialo commentato.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
POSTGRES_USER=netmap
POSTGRES_PASSWORD=admin
POSTGRES_DB=netmap

# Chiave per cifrare community e chiavi SNMP. Se resta vuota viene generata in backend/.secrets_key
# (in produzione in data/secrets_key): non cancellare quel file, altrimenti i profili SNMP vanno reinseriti
SECRETS_KEY=

# Su Linux il controllo dei file cambiati funziona senza polling: metti false (su Windows lascia true)
FILE_POLLING=true
# Nomi host da cui si apre l'interfaccia oltre a IP e localhost (separati da virgola)
VITE_ALLOWED_HOSTS=.netbird.cloud

# Login (fase 4). Al primo accesso l'interfaccia chiede di creare l'amministratore.
# AUTH_ENABLED=false toglie il login (solo per prove in locale). Con HTTPS davanti metti COOKIE_SECURE=true
AUTH_ENABLED=true
SESSION_HOURS=12
COOKIE_SECURE=false
# Stato live: ogni quanti secondi il monitor fa ping/SNMP sui device con IP di management (0 = spento)
MONITOR_INTERVAL_SECONDS=60
